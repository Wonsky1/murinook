      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop items here"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть елементи сюди"
          }
        }
      }
    },
    "shelf.dropNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop to add to Shelf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпустіть, щоб додати на полицю"
          }
        }
      }
    },
    "shelf.dropNowMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item will stay here until you remove it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент залишиться тут, доки ви його не вилучите."
          }

          "stringUnit": {
            "state": "translated",
            "value": "Закрити"
          }
        }
      }
    },
    "shelf.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Shelf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистити полицю"
          }
        }
      }
    },
    "shelf.dragHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep useful items nearby"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте потрібне поруч"
          }
        }
      }
    },

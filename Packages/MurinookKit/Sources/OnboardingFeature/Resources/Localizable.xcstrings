{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
      }
    },
    "onboarding.continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжити"
          }
        }
      }
    },
    "onboarding.eyebrow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A LITTLE NOOK FOR THINGS IN TRANSIT"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗАТИШНЕ МІСЦЕ ДЛЯ РЕЧЕЙ У ДОРОЗІ"
          }
        }
      }
    },
    "onboarding.finish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершити"
          }
        }
      }
    },
    "onboarding.permissionSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility Settings"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити Спеціальні можливості"
          }
        }
      }
    },
    "onboarding.product": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook"
          }
        }
      }
    },
    "onboarding.skip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish setup"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершити налаштування"
          }
        }
      }
    },
    "onboarding.title.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little more room to work"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трохи більше простору для роботи"
          }
        }
      }
    },
    "onboarding.title.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обміну"
          }
        }
      }
    },
    "onboarding.title.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File Shelf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Полиця файлів"
          }
        }
      }
    },
    "onboarding.title.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Management"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керування вікнами"
          }
        }
      }
    },
    "onboarding.message.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook brings your clipboard, a temporary file shelf and window shortcuts together. Choose what fits your day."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook поєднує історію буфера обміну, тимчасову полицю файлів і комбінації клавіш для вікон. Виберіть те, що вам потрібно."
          }
        }
      }
    },
    "onboarding.message.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find something you copied earlier, then copy it again or paste it into another app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть те, що копіювали раніше, а потім скопіюйте знову або вставте в іншу програму."
          }
        }
      }
    },
    "onboarding.message.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary place to hold files and other content while you move between apps. Drag items in, then drag them to their destination."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасове місце для файлів та іншого вмісту, поки ви переходите між програмами. Перетягніть елементи на полицю, а потім — туди, де вони потрібні."
          }
        }
      }
    },
    "onboarding.message.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange the active app’s window with familiar Rectangle-style keyboard shortcuts."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташовуйте вікно активної програми за допомогою знайомих комбінацій клавіш у стилі Rectangle."
          }
        }
      }
    },
    "onboarding.visual.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard history · Shelf · Paste queue"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія буфера · Полиця · Черга вставлення"
          }
        }
      }
    },
    "onboarding.visual.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search and organize your copies"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте й упорядковуйте копії"
          }
        }
      }
    },
    "onboarding.visual.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a few things within reach"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте потрібне під рукою"
          }
        }
      }
    },
    "onboarding.visual.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when to paste each item"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирайте, коли вставляти кожен елемент"
          }
        }
      }
    },
    "onboarding.bullet.0.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your history and preferences stay on this Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія та налаштування зберігаються на цьому Mac."
          }
        }
      }
    },
    "onboarding.bullet.0.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three tools, each with its own on/off switch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три інструменти, кожен із власним перемикачем."
          }
        }
      }
    },
    "onboarding.bullet.1.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep text, links, images and files in a searchable history."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте текст, посилання, зображення й файли в історії з пошуком."
          }
        }
      }
    },
    "onboarding.bullet.1.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin useful items and open Quick Access when you need them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплюйте потрібні елементи та відкривайте Швидкий доступ, коли вони знадобляться."
          }
        }
      }
    },
    "onboarding.bullet.2.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shelf can appear automatically during supported drags."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Полиця може з’являтися автоматично під час перетягування підтримуваного вмісту."
          }
        }
      }
    },
    "onboarding.bullet.2.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide a populated shelf to its edge handle; click to restore it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховайте заповнену полицю в кнопку на краю екрана й натисніть її, щоб розгорнути."
          }
        }
      }
    },
    "onboarding.bullet.3.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, Control–Option–← / → fills the left or right half."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням Control–Option–← / → розташовує вікно в лівій або правій половині."
          }
        }
      }
    },
    "onboarding.bullet.3.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use more layouts and customize shortcuts in Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте інші макети й змінюйте комбінації клавіш у Налаштуваннях."
          }
        }
      }
    },
    "onboarding.step %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld of 4"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Крок %lld із 4"
          }
        }
      }
    },
    "Murinook.diagram.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting notes"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки зустрічі"
          }
        }
      }
    },
    "Murinook.diagram.notePreview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas for Friday…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідеї на п’ятницю…"
          }
        }
      }
    },
    "Murinook.diagram.link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design reference"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зразок дизайну"
          }
        }
      }
    },
    "Murinook.diagram.linkPreview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "example.com/design"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "example.com/design"
          }
        }
      }
    },
    "Murinook.diagram.image": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer palette"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Літня палітра"
          }
        }
      }
    },
    "Murinook.diagram.imagePreview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image copied yesterday"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення скопійовано вчора"
          }
        }
      }
    },
    "Murinook.diagram.shelf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary shelf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасова полиця"
          }
        }
      }
    },
    "Murinook.diagram.file": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes.pdf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки.pdf"
          }
        }
      }
    },
    "Murinook.diagram.drop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop here"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть сюди"
          }
        }
      }
    },
    "Murinook.diagram.shortcut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the next item"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте наступний елемент"
          }
        }
      }
    },
    "backgroundRunning.gotIt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зрозуміло"
          }
        }
      }
    },
    "backgroundRunning.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити"
          }
        }
      }
    },
    "backgroundRunning.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the menu bar icon above to open Murinook again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть значок угорі, щоб знову відкрити Murinook."
          }
        }
      }
    },
    "backgroundRunning.quitPath": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To quit: Murinook icon → Quit Murinook."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вийти: значок Murinook → «Вийти з Murinook»."
          }
        }
      }
    },
    "backgroundRunning.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook is still running"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook продовжує працювати"
          }
        }
      }
    },
    "onboarding.checkPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check access"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірити доступ"
          }
        }
      }
    },
    "onboarding.enabled.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Clipboard"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути буфер обміну"
          }
        }
      }
    },
    "onboarding.enabled.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable File Shelf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути полицю файлів"
          }
        }
      }
    },
    "onboarding.enabled.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Window Management"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути керування вікнами"
          }
        }
      }
    },
    "onboarding.changeLater": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this in Settings. Turning it off keeps your saved items."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можна змінити в Налаштуваннях. Вимкнення зберігає ваші елементи."
          }
        }
      }
    },
    "onboarding.access.paste": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is needed to paste into other apps. Clipboard history and Copy work without it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ потрібен для вставлення в інші програми. Історія буфера обміну й копіювання працюють без нього."
          }
        }
      }
    },
    "onboarding.access.windows": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access is needed to move and resize other apps’ windows."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до Спеціальних можливостей потрібен для переміщення та зміни розміру вікон інших програм."
          }
        }
      }
    },
    "onboarding.access.granted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is available."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ надано."
          }
        }
      }
    },
    "onboarding.access.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is not available yet. You can continue and set it up later."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ ще не надано. Ви можете продовжити й налаштувати його пізніше."
          }
        }
      }
    },
    "onboarding.access.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check access when you’re ready."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте доступ, коли будете готові."
          }
        }
      }
    },
    "onboarding.access.request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надати доступ…"
          }
        }
      }
    }
  },
  "version": "1.0"
}

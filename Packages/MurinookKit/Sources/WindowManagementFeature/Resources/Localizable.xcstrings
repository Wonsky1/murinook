{
  "sourceLanguage": "en",
  "strings": {
    "window.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange windows"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташування вікон"
          }
        }
      }
    },
    "window.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
      }
    },
    "window.settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window management settings…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметри керування вікнами…"
          }
        }
      }
    },
    "window.disabledMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange other apps’ windows from Murinook. Enable Window Management in Settings to get started."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташовуйте вікна інших програм за допомогою Murinook. Щоб почати, увімкніть керування вікнами в параметрах."
          }
        }
      }
    },
    "window.error.accessibilityRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility access for window management in System Settings, then try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте доступ до спеціальних можливостей для керування вікнами в Системних параметрах і спробуйте ще раз."
          }
        }
      }
    },
    "window.error.noWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a window in another app, then try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть вікно в іншій програмі та спробуйте ще раз."
          }
        }
      }
    },
    "window.error.unsupportedWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window cannot be arranged. Exit full screen or choose a movable, resizable window."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вікно неможливо розташувати. Вийдіть із повноекранного режиму або виберіть вікно, яке можна переміщувати й змінювати за розміром."
          }
        }
      }
    },
    "window.error.noOtherDisplay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect another display to move this window between displays."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під’єднайте інший дисплей, щоб перемістити на нього це вікно."
          }
        }
      }
    },
    "window.error.noRestoreFrame": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange this window with Murinook first. Its previous position is kept for this session."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку розташуйте це вікно за допомогою Murinook. Його попередня позиція зберігається протягом цього сеансу."
          }
        }
      }
    },
    "window.error.operationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook couldn’t confirm the requested window position or size. Try the command again. If it keeps happening, the app may limit that window’s size or be temporarily unresponsive."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murinook не вдалося підтвердити потрібну позицію або розмір вікна. Повторіть команду. Якщо це повторюється, можливо, програма обмежує розмір вікна або тимчасово не відповідає."
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    "common.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити"
          }
        }
      }
    },
    "queue.dispatchCaveat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paste command does not confirm that the other app inserted the item."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда вставлення не підтверджує, що інша програма вставила елемент."
          }
        }
      }
    },
    "queue.emptyMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add clips from Quick Access or Library to paste them in sequence."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте фрагменти зі швидкого доступу або бібліотеки, щоб вставляти їх послідовно."
          }
        }
      }
    },
    "queue.emptyTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your queue is empty"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Черга порожня"
          }
        }
      }
    },
